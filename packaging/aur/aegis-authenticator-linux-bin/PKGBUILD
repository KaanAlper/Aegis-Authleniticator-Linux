# Maintainer: KaanAlper
pkgname=aegis-authenticator-linux-bin
_pkgname=aegis-authenticator-linux
pkgver=0.2.0
pkgrel=1
pkgdesc='Native Linux desktop client for Aegis Authenticator 2FA vaults (prebuilt AppImage)'
arch=('x86_64')
url='https://github.com/KaanAlper/Aegis-Authleniticator-Linux'
license=('GPL-3.0-only')
depends=('dbus' 'libxkbcommon' 'wayland' 'gtk3' 'libnotify' 'mesa' 'fuse2')
optdepends=('wl-clipboard: most reliable clipboard on Wayland'
            'zbar: webcam QR scanning')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip')
source=("Aegis-Authenticator-$pkgver-x86_64.AppImage::$url/releases/download/v$pkgver/Aegis-Authenticator-$pkgver-x86_64.AppImage"
        "$_pkgname.png::$url/raw/v$pkgver/assets/icon.png")
noextract=("Aegis-Authenticator-$pkgver-x86_64.AppImage")
sha256sums=('904632eafe8aa7072868402529c3ec65abe3dbf35010cf73ff03eea5c2a46c88'
            'f41992d7dde755c365c83c8bc2e19ac3c3cd183a4c4ad0d36b86b3ec35f56918')

package() {
  install -Dm755 "Aegis-Authenticator-$pkgver-x86_64.AppImage" "$pkgdir/opt/$_pkgname/$_pkgname.AppImage"
  install -d "$pkgdir/usr/bin"
  ln -s "/opt/$_pkgname/$_pkgname.AppImage" "$pkgdir/usr/bin/aegis-linux"
  install -Dm644 "$_pkgname.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/aegis-linux.png"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/aegis-linux.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Aegis Authenticator
Comment=Linux Desktop Client for Aegis 2FA Vaults
Exec=aegis-linux
Icon=aegis-linux
Terminal=false
Categories=Utility;Security;
Keywords=2FA;TOTP;HOTP;OTP;Aegis;Authenticator;
StartupNotify=true
DESKTOP
}
